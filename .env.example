# Copy to .env  (all values optional - defaults run fully locally with SQLite)
DATABASE_URL=sqlite:///./data/claims.db
# DATABASE_URL=postgresql://claims:claims@localhost:5432/claims
REDIS_URL=
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

AUTH_ENABLED=false
# format: key:role,key:role   roles: admin | investigator | viewer
API_KEYS=dev-admin-key:admin,dev-inv-key:investigator,dev-view-key:viewer

CURRENCY=USD
OCR_ENGINE=tesseract        # tesseract | paddle
YOLO_WEIGHTS=               # path to a trained YOLO11 .pt (damage classes); empty = OpenCV heuristic

LLM_PROVIDER=none           # none | anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
