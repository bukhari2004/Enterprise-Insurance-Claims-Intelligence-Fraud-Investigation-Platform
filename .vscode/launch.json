{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API (uvicorn, reload)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8000"],
      "jinja": true,
      "justMyCode": true
    },
    {
      "name": "Seed demo data",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/seed_data.py",
      "args": ["--reset"]
    },
    {
      "name": "Run tests",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "-s", "tests", "-v"]
    }
  ]
}
